{
  "name": "cryptlight",
  "version": "0.1.2",
  "description": "A cryptic crossword clue solving aid",
  "keywords": [
    "puzzles"
  ],
  "homepage": "https://github.com/cjquines/cryptlight#readme",
  "bugs": {
    "url": "https://github.com/cjquines/cryptlight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjquines/cryptlight.git"
  },
  "license": "MIT",
  "author": "CJ Quines <cj@cjquines.com>",
  "type": "module",
  "imports": {
    "#download": {
      "node": "./src/download.node.ts",
      "default": "./src/download.ts"
    }
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/*.test.ts",
    "!src/data/*.txt"
  ],
  "scripts": {
    "build:abbreviations": "tsx scripts/build-abbreviations.ts",
    "build:dsl": "lezer-generator src/dsl/dsl.grammar --typeScript --output src/dsl/parser.ts",
    "build:indicators": "tsx scripts/build-indicators.ts",
    "build:tsc": "tsc --build tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "@lezer/lr": "^1.4.7",
    "compromise": "^14.15.1",
    "cromulence": "^0.6.0",
    "regjsgen": "^0.8.0",
    "regjsparser": "^0.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.0",
    "@types/node": "^26.1.0",
    "@vitest/eslint-plugin": "^1.6.21",
    "csv-parse": "^7.0.1",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
