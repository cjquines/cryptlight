{
  "name": "cryptlight",
  "version": "0.2.0",
  "description": "A cryptic crossword clue solving aid",
  "keywords": [
    "puzzles"
  ],
  "homepage": "https://github.com/cjquines/cryptlight#readme",
  "bugs": {
    "url": "https://github.com/cjquines/cryptlight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjquines/cryptlight.git"
  },
  "license": "MIT",
  "author": "CJ Quines <cj@cjquines.com>",
  "type": "module",
  "imports": {
    "#download": {
      "cryptlight-source": {
        "node": "./src/download.node.ts",
        "default": "./src/download.ts"
      },
      "node": "./dist/download.node.js",
      "default": "./dist/download.js"
    }
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/*.test.ts",
    "!src/data/*.txt"
  ],
  "scripts": {
    "build:abbreviations": "tsx scripts/build-abbreviations.ts",
    "build:indicators": "tsx scripts/build-indicators.ts",
    "build:tsc": "tsc --build tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint",
    "scrape:clueclinic": "tsx scripts/scrape-clueclinic.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "compromise": "^14.20.0",
    "cromulence": "^0.6.3",
    "regjsgen": "^0.8.0",
    "regjsparser": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "csv-parse": "^7.0.3",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
